[Unit]
Description=Vaultaire Nexus - depot de paquets, images et releases
Documentation=file:///usr/share/doc/vaultaire_nexus/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vaultaire-nexus
Group=vaultaire-nexus
ExecStart=/usr/local/bin/vaultaire_nexus -config /etc/vaultaire_nexus/config.yaml
ExecStartPre=/usr/local/bin/vaultaire_nexus -config /etc/vaultaire_nexus/config.yaml -check
Restart=on-failure
RestartSec=5s

# Secrets hors du fichier de configuration :
# EnvironmentFile=-/etc/vaultaire_nexus/nexus.env   (NEXUS_ADMIN_PASSWORD=…, 0600)
EnvironmentFile=-/etc/vaultaire_nexus/nexus.env

StateDirectory=vaultaire_nexus
StateDirectoryMode=0750
LogsDirectory=vaultaire
ConfigurationDirectory=vaultaire_nexus

# Durcissement
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# Ports < 1024 : décommenter.
# AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
