# Rotation des journaux FICHIER du core Vaultaire.
#
#   Destination : /etc/logrotate.d/vaultaire-core
#
# ---------------------------------------------------------------------------
# Ce fichier ne couvre PAS le journal principal du core
# ---------------------------------------------------------------------------
#
# Le core écrit ses lignes sur la sortie standard — Twelve-Factor App — et c'est
# systemd, journald ou le moteur de conteneurs qui les collecte, avec sa propre
# rétention. Les faire tourner ici reviendrait à en tenir deux, et la question
# « où sont les journaux » aurait deux réponses.
#
# Deux familles seulement passent par un fichier, parce qu'on veut pouvoir les
# lire séparément du flot général :
#
#   date.log           dates de naissance refusées à la création d'un compte
#   SQL_Injection.log  identifiants refusés par l'assainissement des requêtes
#
# Les fichiers sont NOMMÉS un par un plutôt que globés. Le glob « *.log »
# ramasserait aussi le journal d'un agent ou d'un proxy installé sur la même
# machine, et deux configurations logrotate qui désignent le même fichier font
# échouer le passage entier — pas seulement l'entrée en double.
#
# ---------------------------------------------------------------------------
# Pourquoi aucune ligne de code n'est nécessaire côté core
# ---------------------------------------------------------------------------
#
# Le core rouvre le fichier PAR SON CHEMIN à chaque ligne. Après le renommage
# que fait logrotate, la ligne suivante recrée le fichier. Ni « copytruncate »
# — qui perd les lignes écrites pendant la copie — ni signal de réouverture.
#
# Cette propriété est écrite dans core/logs/CreateLogs.go et gardée par un test.
# Si quelqu'un garde un jour un descripteur ouvert pour économiser deux appels
# système, il faudra passer à « copytruncate » ou envoyer un signal — sans quoi
# le core continuerait d'écrire dans l'archive et le fichier courant resterait
# vide indéfiniment.

/var/log/vaultaire/date.log
/var/log/vaultaire/SQL_Injection.log
{
    # Un fichier par jour, comme demandé.
    daily

    # 30 archives, soit un mois glissant.
    rotate 30

    # Compression, mais DIFFÉRÉE d'un tour : la plus récente des archives reste
    # en clair. C'est celle qu'on lit le lendemain d'un incident, et devoir la
    # décompresser pour un grep ajoute un geste au pire moment.
    compress
    delaycompress

    # Une taille MAXIMALE en plus de la cadence quotidienne.
    #
    # Sans elle, un incident bavard — une boucle de refus, un scan qui déclenche
    # l'assainissement des requêtes en rafale — remplit la partition avant
    # minuit, et la rotation quotidienne arrive trop tard. Avec elle, logrotate
    # tourne dès le seuil atteint, au passage suivant.
    #
    # Ne fonctionne QUE si logrotate est invoqué plus souvent qu'une fois par
    # jour. Le minuteur systemd standard est quotidien : voir
    # deployments/logrotate/README.md pour le passer à l'heure.
    maxsize 50M

    # Ne pas échouer si le fichier n'existe pas : ces deux familles n'écrivent
    # que sur un événement précis, et un core sain peut n'en avoir jamais eu.
    missingok

    # Ne pas faire tourner un fichier vide : sinon 30 archives vides chassent
    # les vraies au bout d'un mois de calme.
    notifempty

    # Les archives héritent des droits du fichier, mais « create » fixe ceux du
    # fichier NEUF. 0600 root:root : ces journaux nomment des comptes et des
    # tentatives d'injection, ils n'ont pas à être lisibles par les utilisateurs
    # de la machine.
    create 0600 root root

    # Une seule invocation pour tous les fichiers de cette entrée.
    sharedscripts
}
