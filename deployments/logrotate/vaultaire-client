# Rotation du journal de l'agent Vaultaire.
#
#   Destination : /etc/logrotate.d/vaultaire-client
#
# ---------------------------------------------------------------------------
# Ce fichier est le SEUL garde-fou du parc
# ---------------------------------------------------------------------------
#
# L'agent écrit chaque ligne deux fois : sur la sortie standard, que systemd
# collecte dans journald, et dans ce fichier. journald a sa propre rétention ;
# le fichier n'en avait aucune. Il grossissait indéfiniment sur CHAQUE machine
# du parc, et personne ne le voit grossir — c'est le propre d'un parc.
#
# Le fichier est conservé malgré le doublon parce qu'il reste lisible sans
# systemd : conteneur, machine où journald est volatil, copie à joindre à un
# ticket. Et parce qu'en mode « fetch SSH » l'agent fait taire sa sortie
# standard — la sortie est alors le canal de réponse lu par le module PAM — donc
# ces lignes-là n'existent QUE dans ce fichier.
#
# ---------------------------------------------------------------------------
# Pourquoi aucune ligne de code n'est nécessaire côté agent
# ---------------------------------------------------------------------------
#
# L'agent rouvre le fichier PAR SON CHEMIN à chaque ligne. Après le renommage
# que fait logrotate, la ligne suivante recrée le fichier. Ni « copytruncate »
# — qui perd les lignes écrites pendant la copie — ni signal de réouverture, ni
# redémarrage du service.
#
# C'est une propriété du code, pas un hasard : elle est écrite dans le socle
# (duckynetwork/logs/CreateLogs.go) et gardée par un test. Elle se détruirait en
# une ligne, le jour où quelqu'un garderait le descripteur ouvert pour économiser
# deux appels système — et le symptôme serait un journal qui s'arrête net après
# la première rotation, sans erreur.

/var/log/vaultaire/vaultaire_client.log {
    # Un fichier par jour, comme demandé.
    daily

    # 30 archives, soit un mois glissant.
    #
    # C'est la fenêtre pendant laquelle on peut encore remonter un incident
    # signalé tardivement — « ça a commencé il y a trois semaines ».
    rotate 30

    # Compression différée d'un tour : la plus récente reste en clair, c'est
    # celle qu'on lit le lendemain d'un incident.
    compress
    delaycompress

    # Une taille maximale EN PLUS de la cadence quotidienne.
    #
    # Sur un poste, l'emballement typique est une boucle d'authentification qui
    # échoue : chaque tentative écrit, et la partition /var se remplit bien avant
    # minuit. La rotation quotidienne arriverait trop tard.
    #
    # 20 Mo par fichier, 30 archives : au pire 600 Mo, compressés pour la
    # plupart. Sur un poste c'est acceptable ; si ça ne l'est pas, c'est
    # « rotate » qu'il faut baisser, pas « maxsize ».
    #
    # Ne fonctionne QUE si logrotate est invoqué plus souvent qu'une fois par
    # jour — voir README.md.
    maxsize 20M

    missingok
    notifempty

    # 0600 root:root. Ce journal nomme les comptes qui se connectent, ceux dont
    # l'authentification est refusée, et les groupes du domaine posés sur la
    # machine. Il était créé en 0644 : tout utilisateur du poste pouvait lire
    # les tentatives de connexion des autres.
    create 0600 root root

    sharedscripts
}
