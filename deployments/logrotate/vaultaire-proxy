# Rotation du journal du proxy Vaultaire.
#
#   Destination : /etc/logrotate.d/vaultaire-proxy
#
# Le proxy tourne sur le même socle réseau que l'agent, dont le nom de journal
# par défaut est « vaultaire_client.log ». Il pose le sien au démarrage —
# storage.NomJournal, dans son main — sans quoi son journal atterrirait dans le
# fichier de l'agent, sous un nom qui annonce autre chose que son contenu.
#
# C'est aussi ce qui permet à cette entrée-ci d'exister : une politique de
# rétention PAR ENTITÉ suppose un fichier par entité.
#
# La rotation ne demande aucune ligne de code, pour la même raison que pour
# l'agent : le fichier est rouvert par son chemin à chaque ligne, donc un
# renommage est suivi tout seul. Voir deployments/logrotate/vaultaire-client.

/var/log/vaultaire/vaultaire_proxy.log {
    daily
    rotate 30

    compress
    delaycompress

    # Plus haut que pour un agent, et volontairement.
    #
    # Un proxy voit passer le trafic de plusieurs machines : son volume normal
    # est un multiple de celui d'un poste. Un seuil de poste le ferait tourner
    # plusieurs fois par jour en fonctionnement sain, et les 30 archives ne
    # couvriraient plus un mois mais quelques jours — c'est-à-dire que la
    # protection contre l'emballement mangerait la rétention.
    maxsize 100M

    missingok
    notifempty
    create 0600 root root
    sharedscripts
}
