FROM rockylinux:9

LABEL maintainer="adm-lviguie"
LABEL description="Vaultaire Dev Server - Rocky Linux based"
LABEL env="dev"

# Installation de Go (Rocky 9 possède Go 1.21+ dans ses dépôts officiels)
# Si tu as besoin d'une version très spécifique, on peut l'installer manuellement,
# mais dnf est plus propre ici.
RUN dnf install -y \
    sudo \
    openssh-server \
    openssh-clients \
    golang \
    git \
    ca-certificates \
    && dnf clean all

# Création de l'utilisateur
RUN useradd -m -d /opt/vaultaire -s /bin/bash vaultaire

# Préparation des répertoires
RUN mkdir -p /var/log/vaultaire /app && \
    chown -R vaultaire:vaultaire /opt/vaultaire /var/log/vaultaire /app && \
    chmod 770 /opt/vaultaire /var/log/vaultaire /app

# Configuration SSH basique pour autoriser les connexions si besoin
RUN ssh-keygen -A

USER vaultaire
WORKDIR /app

# L'environnement est défini ici, mais peut être écrasé par le docker-compose
ENV VAULTAIRE_ENV=dev
ENV GOPATH=/opt/vaultaire/go
ENV PATH=$PATH:$GOPATH/bin

# Commande par défaut
CMD ["go", "run", "./main"]