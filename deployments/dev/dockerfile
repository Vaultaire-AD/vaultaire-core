# Dev image: Go only, no app build. Source is mounted at runtime.
# Restart the container to pick up code changes (or use go run ./main from mounted dir).

FROM golang:1.26.0-alpine3.23

RUN apk add --no-cache git ca-certificates openssh-client

WORKDIR /app
COPY --chown=vaultaire:vaultaire ./deployments/configs/ /opt/vaultaire/
COPY --chown=vaultaire:vaultaire ./cmd/vaultaire_client/ /opt/vaultaire/vaultaire_client/
COPY --chown=vaultaire:vaultaire ./automatisation/auto_deployements/ /opt/vaultaire/automatisation/

# No COPY of app source - mount from host in docker-compose.
# Default: run the server. Override to run tests: go run ./main --test
CMD ["go", "run", "./main"]
