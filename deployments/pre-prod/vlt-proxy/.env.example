# Configuration du proxy Vaultaire.
#
#   cp .env.example .env   puis renseigner
#
# .env contient la clé d'enrôlement : il ne doit PAS être commité.

# Adresse du core, hôte:port.
VAULTAIRE_IP_CORE=vaultaire-ad:6666

# Clé d'enrôlement, créée sur le core :
#   vlt enroll create --type vaultaire_proxy --uses 5 --expires 24h
#
# Elle porte le TYPE du client : c'est elle qui décide de ce que le core laissera
# ce proxy émettre. Le proxy ne peut pas déclarer son type lui-même.
#
# Lue au premier démarrage seulement, ou après --reset-identity.
VAULTAIRE_ENROLL_KEY=CHANGEZ-MOI

# Adresse à laquelle CE proxy est joignable, telle qu'affichée dans le cluster.
# Requise : sans elle, la ligne du cluster serait décorative.
VAULTAIRE_PROXY_ENDPOINT=vlt-proxy:389

# Nom lisible côté core. Purement descriptif.
VAULTAIRE_PROXY_LABEL=proxy-preprod-01

# Répertoire d'identité. Doit correspondre au volume monté dans le compose.
VAULTAIRE_KEY_DIR=/var/lib/vaultaire_proxy/keys
