{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Valeurs de la chart vaultaire",
  "type": "object",
  "required": [
    "image",
    "auth",
    "database",
    "mariadb",
    "config",
    "service",
    "persistence"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "auth": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "mountAsFiles": {
          "type": "boolean"
        },
        "secretKeys": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "dbPassword": {
          "type": "string"
        },
        "adminPassword": {
          "type": "string"
        },
        "dbRootPassword": {
          "type": "string"
        },
        "adminPublicKey": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "port",
        "name",
        "username"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "username": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mariadb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "ldap": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ldapsEnabled": {
              "type": "boolean"
            },
            "requireTlsForBind": {
              "type": "boolean"
            },
            "mfaBypass": {
              "type": "boolean"
            },
            "oneLevelSubtree": {
              "type": "boolean"
            },
            "tlsDnsNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tlsIpAddresses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "web": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tlsDnsNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tlsIpAddresses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "trustedProxies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "api": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rateBurst": {
              "type": "integer",
              "minimum": 1
            },
            "ratePerSecond": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "dns": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "debug": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "detail": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "off",
                  "debug",
                  "trace"
                ]
              }
            }
          }
        },
        "admin": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "username": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "override": {
          "type": "string"
        }
      }
    },
    "logFormat": {
      "enum": [
        "json",
        "text"
      ]
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "ports"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "externalTrafficPolicy": {
          "enum": [
            "Local",
            "Cluster"
          ]
        },
        "ports": {
          "type": "object",
          "properties": {
            "ducky": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "nodePort": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "enabled",
                "port"
              ]
            },
            "ldap": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "nodePort": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "enabled",
                "port"
              ]
            },
            "ldaps": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "nodePort": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "enabled",
                "port"
              ]
            },
            "web": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "nodePort": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "enabled",
                "port"
              ]
            },
            "api": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "nodePort": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "enabled",
                "port"
              ]
            },
            "dns": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "nodePort": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "enabled",
                "port"
              ]
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "tls": {
      "type": "object",
      "properties": {
        "ldaps": { "$ref": "#/$defs/tlsService" },
        "web": { "$ref": "#/$defs/tlsService" },
        "api": { "$ref": "#/$defs/tlsService" },
        "certManager": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "services": {
              "type": "array",
              "items": { "enum": ["ldaps", "web", "api"] },
              "uniqueItems": true
            },
            "issuerRef": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string" },
                "group": { "type": "string" }
              }
            },
            "duration": { "type": "string" },
            "renewBefore": { "type": "string" },
            "privateKey": { "type": "object" },
            "extraDnsNames": { "type": "array", "items": { "type": "string" } },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "restrictEgress": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "tlsService": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" }
      }
    }
  }
}
