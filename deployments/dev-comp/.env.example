# Copier en .env pour changer les ports publiés (tous facultatifs).
# Les valeurs par défaut sont celles de la préprod : n'ouvrez pas les deux piles
# en même temps sur la même machine, ou décalez ici.
DEVCOMP_PORT_DUCKY=6666
DEVCOMP_PORT_WEB=4443
DEVCOMP_PORT_API=6643
DEVCOMP_PORT_LDAP=389
DEVCOMP_PORT_LDAPS=636
DEVCOMP_PORT_DB=3307
# Proxy (profil « proxy ») : port publié du relais Ducky.
DEVCOMP_PORT_PROXY=6667
# Clé d'enrôlement du proxy (vlt enroll create --type vaultaire_proxy).
DEVCOMP_PROXY_ENROLL_KEY=
# Nexus (profil « nexus »).
DEVCOMP_PORT_NEXUS=8843
DEVCOMP_NEXUS_PUBLIC_URL=https://localhost:8843
# Mot de passe du compte admin ; vide → généré dans le volume (admin.initial).
DEVCOMP_NEXUS_ADMIN_PASSWORD=
