+		// soit l'ordre dans lequel elles arrivent.
+		if !p.Autorise("ENOV.LOCAL") {
+			t.Fatalf("appel %d : « ENOV.LOCAL » refusé après mémorisation de %q", i, parent)
+		}
+	}
+}
